<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#F5F7FA"
  android:fillViewport="true"
  tools:context=".ViewUserProfileActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tv_detail_username"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#111827"
          android:textSize="24sp"
          android:textStyle="bold"
          tools:text="nguyen_an" />

        <TextView
          android:id="@+id/tv_detail_id"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="#6B7280"
          android:textSize="16sp"
          tools:text="ID: 1" />
      </LinearLayout>

      <ImageView
        android:id="@+id/iv_detail_avatar"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:contentDescription="@string/avatar"
        android:scaleType="centerCrop"
        tools:src="@android:drawable/ic_menu_gallery" />
    </LinearLayout>

    <TextView
      android:id="@+id/tv_detail_email"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:textColor="#1F2937"
      android:textSize="17sp"
      tools:text="Email: an@example.com" />

    <TextView
      android:id="@+id/tv_detail_tel"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:textColor="#1F2937"
      android:textSize="17sp"
      tools:text="Tel: 0901234567" />

    <TextView
      android:id="@+id/tv_detail_hobby"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:textColor="#1F2937"
      android:textSize="17sp"
      tools:text="Hobby: Lập trình" />

    <TextView
      android:id="@+id/tv_detail_description"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:textColor="#4B5563"
      android:textSize="16sp"
      tools:text="Mô tả hồ sơ" />
  </LinearLayout>
</ScrollView>
